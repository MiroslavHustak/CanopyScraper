<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Secrets\secrets.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Secrets\secrets.json</Link>
		</Content>
		<Compile Include="CEBuilders.fs" />
		<Compile Include="ResultExtensions.fs" />
		<Compile Include="OptionExtensions.fs" />
		<Compile Include="Settings.fs" />
		<Compile Include="Helpers.fs" />
		<Compile Include="Secrets\ApiKeys.fs" />
		<Compile Include="InputData.fs" />
		<Compile Include="ThothCoders.fs" />
		<Compile Include="Serialization.fs" />
		<Compile Include="EdgeDriver.fs" />
		<Compile Include="ApiClient.fs" />
		<Compile Include="ProgramChrome.fs" />
		<Compile Include="Kodis.fs" />
		<Compile Include="Start.fs" />
		<None Include="Dockerfile" />
		<Content Include="DockerCommands" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="canopy" Version="2.1.5" />
		<PackageReference Include="FsHttp" Version="15.0.3" />
		<PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
		<PackageReference Include="Thoth.Json.Net" Version="12.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="FSharp.Core" Version="9.0.303" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="bin\Release\net8.0\ShutDownMsg\" />
	</ItemGroup>

</Project>
